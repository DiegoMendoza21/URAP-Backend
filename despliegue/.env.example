# Variables del despliegue (docs/despliegue.md). Copie este archivo como despliegue/.env en el
# servidor y complete los valores. El .env nunca va al repositorio.
#
# NODE_ENV, PUERTO, ALMACENAMIENTO_DIRECTORIO, PROXIES_CONFIABLES y CORS_ORIGENES los fija
# docker-compose.yml: no hace falta ponerlos aquí.

# --- Dominio ---
# Nombre con el que se abre URAP, sin https://. Debe apuntar a la IP elástica del servidor.
# Sin dominio propio sirve uno de sslip.io con la IP, por ejemplo 3-91-20-14.sslip.io.
DOMINIO=

# --- Base de datos (Amazon RDS, MySQL 8.4) ---
# La URL termina con la CA de RDS: la conexión va cifrada y se verifica el certificado del
# servidor (NFR-006). La API no arranca en producción sin sslcert.
# Si la contraseña tiene caracteres especiales (@ : / ? #), escríbalos codificados (%40, %3A…).
DATABASE_URL=mysql://urap:CONTRASENA@ENDPOINT-DE-RDS:3306/urap?sslcert=/certificados/global-bundle.pem&sslaccept=strict

# --- Autenticación (NFR-003) ---
# Genere el secreto en el servidor con:
#   openssl rand -base64 48
JWT_SECRETO=
JWT_EXPIRACION_MINUTOS=480
INICIO_SESION_LIMITE_POR_IP=10
INICIO_SESION_VENTANA_SEGUNDOS=60

# --- Datos de demostración ---
# Solo para el servidor de la demostración. Contraseña de admin.demo@urap.local y los demás
# usuarios ficticios: al menos 12 caracteres, distinta de cualquier otra. Ver la guía.
CONTRASENA_USUARIOS_DEMO=

# --- Rutas en el servidor (opcionales; estos son los valores por defecto) ---
# URAP_ALMACENAMIENTO=/srv/urap/almacenamiento
# URAP_CERTIFICADOS=/srv/urap/certificados
# URAP_FRONTEND=../../URAP-Frontend
