  created_at         DateTime?            @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at         DateTime?            @updatedAt @db.DateTime(0)
  rap                rap?                 @relation(fields: [id_rap], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "indicador_rap_ibfk_1")
