  proyecto_docente      proyecto_docente?       @relation(fields: [id_proyecto_docente], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matricula_ibfk_1")
  estudiante            estudiante?             @relation(fields: [id_estudiante], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matricula_ibfk_2")
  usuario               usuario?                @relation(fields: [id_cargado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matricula_ibfk_3")
