  id_rap                                          Int?
  id_rubrica                                      Int?
  tipo_valoracion                                 String?              @db.VarChar(255)
  periodo_toma                                    String?              @db.VarChar(255)
  anio_toma                                       Int?
  tamano_cohorte                                  Int?
  porcentaje_esperado                             Decimal?             @db.Decimal(5, 2)
  estado                                          String?              @db.VarChar(255)
