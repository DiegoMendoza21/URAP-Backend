  fecha_subida        DateTime?         @db.DateTime(0)
  proyecto_docente    proyecto_docente? @relation(fields: [id_proyecto_docente], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "documento_soporte_ibfk_1")
  usuario             usuario?          @relation(fields: [id_subido_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "documento_soporte_ibfk_2")

