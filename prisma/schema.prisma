  rap               rap?               @relation(fields: [id_rap], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "lider_rap_ibfk_1")
  usuario           usuario?           @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "lider_rap_ibfk_2")
  periodo_academico periodo_academico? @relation(fields: [id_periodo], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "lider_rap_ibfk_3")

  @@unique([id_rap, id_usuario, id_periodo], map: "lider_rap_index_10")
  @@index([id_periodo], map: "id_periodo")
  @@index([id_usuario], map: "id_usuario")
}

model matricula {
  id                    Int                     @id @default(autoincrement())
  id_proyecto_docente   Int?
  id_estudiante         Int?
  estado                String?                 @db.VarChar(255)
  fecha_carga           DateTime?               @db.DateTime(0)
