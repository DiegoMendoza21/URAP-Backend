// Modelos de URAP para Prisma.
//
// La línea base (prisma/migrations/0_init) se obtuvo una sola vez con `prisma db pull` sobre
// la base creada con docs/URAP_esquema_mysql_v2.4.sql. Desde ahí este archivo se mantiene a
// mano: cada cambio empieza en el DBML, se refleja aquí y llega a la base como migración
// (`npm run db:migrar`). Ningún cambio está terminado hasta que el DBML y la migración digan
// lo mismo (ver docs/modelo-datos.md).
//
// Todo campo `updated_at` lleva @updatedAt: el DDL no tiene ON UPDATE y lo actualiza Prisma.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "mysql"
}

model asignatura {
  id                                                                            Int                    @id @default(autoincrement())
  id_programa                                                                   Int?
  codigo_interno                                                                String?                @db.VarChar(255)
  nombre                                                                        String?                @db.VarChar(255)
  semestre                                                                      Int?
  componente                                                                    String?                @db.VarChar(255)
  tipo_curso                                                                    String?                @db.VarChar(255)
  creditos                                                                      Int?
  horas_ti                                                                      Int?
  horas_tde                                                                     Int?
  horas_tdp                                                                     Int?
  horas_totales                                                                 Int?
  activo                                                                        Boolean?               @default(true)
  created_at                                                                    DateTime?              @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at                                                                    DateTime?              @updatedAt @db.DateTime(0)
  programa                                                                      programa?              @relation(fields: [id_programa], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "asignatura_ibfk_1")
  asignatura_rap                                                                asignatura_rap[]
  asignatura_requisito_asignatura_requisito_id_asignaturaToasignatura           asignatura_requisito[] @relation("asignatura_requisito_id_asignaturaToasignatura")
  asignatura_requisito_asignatura_requisito_id_asignatura_requeridaToasignatura asignatura_requisito[] @relation("asignatura_requisito_id_asignatura_requeridaToasignatura")
  proyecto_docente                                                              proyecto_docente[]

  @@unique([id_programa, codigo_interno], map: "asignatura_index_3")
}

model asignatura_rap {
  id_asignatura Int
  id_rap        Int
  activo        Boolean?   @default(true)
  asignatura    asignatura @relation(fields: [id_asignatura], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "asignatura_rap_ibfk_1")
  rap           rap        @relation(fields: [id_rap], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "asignatura_rap_ibfk_2")

  @@id([id_asignatura, id_rap])
  @@index([id_rap], map: "id_rap")
}

model asignatura_requisito {
  id_asignatura                                                       Int
  id_asignatura_requerida                                             Int
  tipo                                                                String     @db.VarChar(255)
  asignatura_asignatura_requisito_id_asignaturaToasignatura           asignatura @relation("asignatura_requisito_id_asignaturaToasignatura", fields: [id_asignatura], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "asignatura_requisito_ibfk_1")
  asignatura_asignatura_requisito_id_asignatura_requeridaToasignatura asignatura @relation("asignatura_requisito_id_asignatura_requeridaToasignatura", fields: [id_asignatura_requerida], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "asignatura_requisito_ibfk_2")

  @@id([id_asignatura, id_asignatura_requerida, tipo])
  @@index([id_asignatura_requerida], map: "id_asignatura_requerida")
}

model auditoria {
  id             Int       @id @default(autoincrement())
