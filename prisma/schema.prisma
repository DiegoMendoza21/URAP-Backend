  id_nivel              Int?
  medicion_indicador    medicion_indicador? @relation(fields: [id_medicion_indicador], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "valoracion_estudiante_ibfk_1")
  matricula             matricula?          @relation(fields: [id_matricula], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "valoracion_estudiante_ibfk_2")
  nivel_escala          nivel_escala?       @relation(fields: [id_nivel], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "valoracion_estudiante_ibfk_3")

  @@unique([id_medicion_indicador, id_matricula], map: "valoracion_estudiante_index_17")
  @@index([id_matricula], map: "id_matricula")
  @@index([id_nivel], map: "id_nivel")
}
