  id_cerrado_por                                  Int?
  fecha_cierre                                    DateTime?            @db.DateTime(0)
  created_at                                      DateTime?            @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at                                      DateTime?            @updatedAt @db.DateTime(0)
  medicion_indicador                              medicion_indicador[]
  proyecto_docente                                proyecto_docente?    @relation(fields: [id_proyecto_docente], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medicion_rap_ibfk_1")
  rap                                             rap?                 @relation(fields: [id_rap], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medicion_rap_ibfk_2")
  rubrica                                         rubrica?             @relation(fields: [id_rubrica], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medicion_rap_ibfk_3")
  usuario_medicion_rap_id_registrado_porTousuario usuario?             @relation("medicion_rap_id_registrado_porTousuario", fields: [id_registrado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medicion_rap_ibfk_4")
  usuario_medicion_rap_id_cerrado_porTousuario    usuario?             @relation("medicion_rap_id_cerrado_porTousuario", fields: [id_cerrado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medicion_rap_ibfk_5")

