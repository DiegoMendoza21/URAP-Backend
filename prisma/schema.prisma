  ip             String?   @db.VarChar(255)
  usuario        usuario?  @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "auditoria_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model bibliografia {
  id                  Int               @id @default(autoincrement())
