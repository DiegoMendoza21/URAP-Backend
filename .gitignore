# Dependencias y compilación
node_modules/
dist/
coverage/
*.tsbuildinfo

# Cliente de Prisma generado: se regenera con `npm install` o `npm run db:generar`
/src/generated/

# Variables de entorno: nunca al repositorio
.env
.env.*
!.env.example

# Almacenamiento documental local (ALMACENAMIENTO_DIRECTORIO): evidencias con datos personales
/almacenamiento/
# Red de seguridad: si la carpeta raíz del almacenamiento llegara a ser la del proyecto, las
# evidencias quedarían aquí (sus claves empiezan por evidencias/). Tampoco van al repositorio.
/evidencias/

# Registros
logs/
*.log

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Configuración personal de Claude Code
.claude/settings.local.json
