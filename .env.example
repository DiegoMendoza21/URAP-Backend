# Copie este archivo como .env y complete los valores. El .env nunca va al repositorio.

# --- Aplicación ---
NODE_ENV=development
PUERTO=3001
# Orígenes autorizados por CORS (NFR-006), separados por coma. El frontend (Next.js) usa el 3000.
CORS_ORIGENES=http://localhost:3000
# Balanceadores de carga delante del servidor de Next.js del frontend. El navegador no llama
# a la API: Next.js reenvía cada petición con el X-Forwarded-For tal como le llega, sin agregar
# su propia entrada, así que Next.js no se cuenta. En local, 0: el navegador está en el mismo
# equipo. En el despliegue, el número de balanceadores delante de Next.js (con uno, 1). Con 0
# en el despliegue, todos los usuarios llegan con la IP de Next.js: comparten el límite de
# intentos por IP y la auditoría guarda esa IP en vez de la suya. No ponga más de los que
# hay, no exponga la API a internet ni Next.js sin balanceador: el usuario podría falsificar
# su IP con ese encabezado.
PROXIES_CONFIABLES=0

# --- Autenticación (NFR-003) ---
# Secreto de firma del JWT, de al menos 32 caracteres. La API no arranca sin él. Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
# Vigencia del token en minutos. Va en el entorno y no en parametro_sistema: no debe poder
# cambiarse desde la aplicación.
JWT_EXPIRACION_MINUTOS=480
# Límite de intentos de inicio de sesión por IP en la ventana de segundos indicada (HU-01-04).
# Es un ajuste del despliegue. El bloqueo por cuenta (intentos y minutos) no va aquí: está en
# la tabla parametro_sistema.
INICIO_SESION_LIMITE_POR_IP=10
INICIO_SESION_VENTANA_SEGUNDOS=60

# --- Datos de demostración (npm run db:sembrar:demo) ---
# Contraseña de los usuarios ficticios de demostración (admin.demo@urap.local y los demás),
# de al menos 12 caracteres. Solo para ambientes locales y de demostración.
CONTRASENA_USUARIOS_DEMO=

# --- Base de datos ---
# URL que usan el CLI de Prisma y la API. Debe coincidir con los valores de MySQL de abajo.
DATABASE_URL=mysql://urap:urap_local@localhost:3307/urap
# Base sombra de `prisma migrate dev` (solo desarrollo). Docker la crea como <MYSQL_DATABASE>_sombra.
SHADOW_DATABASE_URL=mysql://urap:urap_local@localhost:3307/urap_sombra

# --- MySQL local en Docker (docker-compose.yml) ---
MYSQL_DATABASE=urap
MYSQL_USER=urap
MYSQL_PASSWORD=urap_local
MYSQL_ROOT_PASSWORD=urap_root_local
MYSQL_PUERTO_LOCAL=3307
